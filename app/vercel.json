{
  "buildCommand": "npx expo export --platform web && cp public/privacy-policy.html dist/privacy-policy.html && cp public/delete-account.html dist/delete-account.html",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "redirects": [
    { "source": "/BillScan", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
