{
  "buildCommand": "npx expo export --platform web && cp public/privacy-policy.html dist/privacy-policy.html",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "redirects": [
    { "source": "/BillScan", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

